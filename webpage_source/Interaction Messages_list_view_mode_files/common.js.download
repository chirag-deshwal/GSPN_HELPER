/**
 * 그리드 객체 노드 삭제함수.
 * 
 * @param form
 *            Form 객체 ID 값
 */
function clearGridJsonObject(form) {
	var length = $(form).childNodes.length;
	for ( var i = length - 1; i >= 0; i--) {
		$(form).removeChild($(form).childNodes[i]);
	}
}

/**
 * 데이터가 없을 시 그리드에 표시할 함수.
 * 
 * @param form
 *            Form 객체 ID 값
 * @param colspan
 *            Colspan 값
 * @param displayMsg
 *            화면에 표시할 데이터.
 * @return
 */
function appendGridNoObjectDisplay(form, colspan, displayMsg, pagingElementId) {
	/**
	 * 변수 초기화
	 */
	initialDisplayRowVariable();

	/**
	 * 그리드 객체 변수 설정.
	 */
	var tbodyObj = $(form);

	/**
	 * 여러번 이 함수가 호출될경우 Data not found 행이 여러건 생기는거 방지
	 */
	clearGridJsonObject(tbodyObj);

	var trTag = document.createElement("tr");

	/** 데이터 없음 */
	var tdTag = document.createElement("td");
	tdTag.colSpan = colspan;
	tdTag.align = "center";
	tdTag.className = "td_al";
	tdTag.appendChild(document.createTextNode(displayMsg));
	trTag.appendChild(tdTag);
	tbodyObj.appendChild(trTag);

	/**
	 * 페이징 엘리먼트 값이 오지 않을 경우.
	 */
	if (pagingElementId == undefined || pagingElementId == null
			|| pagingElementId == "") {
		/** 데이터 설정이 완료되면 프로그래스바를 보이지 않도록 한다. */
		$('progressloading').stopWaiting();
		/** 페이징 화면을 보이지 않도록 한다. */
		if($('pagingProcess')){$('pagingProcess').hide()};
	} else {
		/** 데이터 설정이 완료되면 프로그래스바를 보이지 않도록 한다. */
		$('progressloading').stopWaiting();
		/** 페이징 화면을 보이지 않도록 한다. */
		$(pagingElementId).hide();
	}
}

/**
 * 그리드 데이터 로딩완료 함수
 * 
 * @param searchPageNo
 *            현재 페이지 번호
 * @param searchBlckNo
 *            현재 블럭 번호
 * @param totRow
 *            총 데이터 개수
 * @param pagingCmd
 *            페이징 명령어
 * @param pagingType
 *            'DB': DB 데이터 호출 페이지 함수, 'SAP' 데이터 호출 페이지 함수
 * @param pagingElementId
 *            페이징 화면이 보여지는 DOM Element ID
 * @return
 */
function loadingComplete(searchPageNo, searchBlckNo, totRow, pagingCmd,
		pagingType, pagingElementId) {
	if (pagingElementId == undefined || pagingElementId == null
			|| pagingElementId == "") {
		pagingElementId = 'pagingProcess';
	}

	/** 페이지 처리 함수 호출 */
	paging(searchPageNo, searchBlckNo, totRow, pagingCmd, pagingType,
			pagingElementId);

	/** 데이터 설정이 완료되면 프로그래스바를 보이지 않도록 한다. */
	$('progressloading').stopWaiting();
}

/**
 * Alternates the background color of rows of table or tbody.
 * @param element
 * 			(String) table or tbody element
 * @param oddEven
 * 			(String) odd or even
 * @param color
 * 			(String) color
 */
function alternateTableRowColors(element, oddEven, color) {
	
	$j(element + ' tr:' + oddEven + ' td').css('background-color', color);
	
}

//오늘 날자 구하기
function cfToday() {
	date = new Date();
	var year = date.getYear();
	var month = date.getMonth()+1;
 	var day = date.getDate();

	if (month < 10) month = "0" + month;
	if (day < 10) day = "0" + day;

	return year + "" + month + "" + day;
}

/**
 * common function prefix : cf 전체선택/해제
 * 
 * @param src :
 *            상단의 checkbox id
 * @param dest :
 *            목록에 있는 checkbox name
 * @return src의 체크상태를 모든 dest객체에게 정의한다.
 */
function cfSelectDeselectAll(src, dest) {
	var srcObj = $(src);
	var destObj = cfArray(document.getElementsByName(dest));
	var isChecked = srcObj.checked;

	if (!destObj) {
		return;
	}
	
	for (i = 0, max = destObj.length; i < max; i++) {
		var obj = destObj[i];
		if(!obj.disabled){
			obj.checked = isChecked;
		}
	}

	
	//if (destObj.length) {
	//	for (i = 0, max = destObj.length; i < max; i++) {
	//		destObj[i].checked = isChecked;
	//	}
	//} else {
	//	destObj.checked = isChecked;
	//}
}

/**
 * common function prefix : cf 체크박스에서 선택된것들만 배열로 리턴
 * 
 * @param src :
 *            목록에 있는 checkbox name
 * @return src중에서 체크된것들을 배열로 리턴
 */
function cfCheckedArray(src) {
	var cartPart = $A(document.getElementsByName(src));
	var part = [];

	for ( var i = 0, len = cartPart.length; i < len; i++) {
		if (cartPart[i].checked) {
			part.push(cartPart[i].value);
		}
	}
	return part;
}

/**
 * Ajax 비동기 호출 메소드
 * 
 * @param action :
 *            URI
 * @param form :
 *            post할 값이 있는 HTML Form tag
 * @param callback :
 *            HTTP 200일경우 callback메소드 호출
 * @return
 */
function AjaxRequest(action, form, callback) {
	try {
		var params = Form.serialize($(form));
		new Ajax.Request(action, {
			method : 'post',
			parameters : params,
			onComplete : callback
		});
	} catch (e) {
	}
}

/**
 * Ajax 동기 호출 메소드
 * 
 * @param action :
 *            URI
 * @param form :
 *            post할 값이 있는 HTML Form tag
 * @param callback :
 *            HTTP 200일경우 callback메소드 호출
 * @return
 */
function AjaxSyncRequest(action, form, callback) {
	try {
		var params = Form.serialize($(form));
		new Ajax.Request(action, {
			method : 'post',
			parameters : params,
			asynchronous : false,
			onComplete : callback
		});
	} catch (e) {
	}
}

/**
 * Ajax 호출 메소드
 * 
 * @param parts :
 *            cart에 담을 자재번호가 담긴 배열 예) ["BN07-001","BN07-002"]
 * @return
 */
function cfAddCart(parts) {
	try {
		$('progressloading').startWaiting();
		var params = "cmd=AddCartCmd";
		parts.each(				
				function(item){
					params += "&part=" + item;
				}
		);

		new Ajax.Request('/gspn/operate.do', {
			method : 'post',
			parameters : params,
			onComplete : function(response){
				var json = response.responseText.evalJSON();
				if(json.success) {
					alert(addToCartSuccessMsg);
				}else{
					alert(addToCartFailMsg);
				}
				$('progressloading').stopWaiting();
			}
		});
	} catch (e) {
	}
}

/**
 * Ajax 호출 메소드 
 * cfCreatePo("MR",[{"part":"BN07-0001", "qty":"1", "refNo":"4000123", "shipMethod":"A", "reqNo":"120001", "reqItemNo":"0001"},{}]);
 * 
 * @param referer : MR:Material Request에서 create po낼경우
 * @param arrPart :
 *            po로 넘길 파라미터들 표현하는 object의 배열c
 * @return
 */

function cfCreatePo(referer, arrPart){
	var url = "/order/po/POVerify.jsp?referer=" + referer;
	arrPart.each(
			function(obj){
				url += "&poPart=" + cfV(obj.part);
				url += "&poQty=" + cfV(obj.qty);
				url += "&poRefNo=" + cfV(obj.refNo);
				url += "&poShipMethod=" + cfV(obj.shipMethod);
				url += "&poReqNo=" + cfV(obj.reqNo);
				url += "&poReqItemNo=" + cfV(obj.reqItemNo);				
			}
	);
	
	document.location.href = url;	
}

function cfCreatePoToDisty(referer, arrPart){
	var url = "/disty/purchase/purchaseOrderCreate.jsp?referer=" + referer;
	arrPart.each(
			function(obj){
				url += "&poPart=" + cfV(obj.part);
				url += "&poQty=" + cfV(obj.qty);
				url += "&poRefNo=" + cfV(obj.refNo);
				url += "&poShipMethod=" + cfV(obj.shipMethod);
				url += "&poReqNo=" + cfV(obj.reqNo);
				url += "&poReqItemNo=" + cfV(obj.reqItemNo);				
			}
	);
	
	document.location.href = url;	
}

function cfV(val){
	if(val) return val;
	else return "";
}

/**
 * 자재검색 팝업 : 이관우 과장 추가(for Inventory)
 * 
 * @param part :
 *            검색할 자재명의 ID <input type="text" id="part" value="BN07-000*"><SAPN
 *            id="partCode"></SPAN>
 * @param desc :
 *            선택된 자재명이 박힐곳의 id 예) onclick="cfSearchPopPart('part','partCode')"
 */

function cfSearchPopParts(part, dest, idx) {
	
	if (!idx)
		idx = 0;
	
	var src = $A(document.getElementsByName(part));
	var url = '/invmgnt/mr/PartsSearchPop.jsp?returnId=' + dest + '&partNo='
			+ src[idx].value + '&idx=' + idx;
	url = url + "&t=" + (new Date()).getTime();
	w = window.open(
					url,
					"part_popup",
					'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=no,top=150,left=200,width=800,height=670');
	w.focus();
}


