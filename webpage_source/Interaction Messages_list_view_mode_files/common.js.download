/**
 * 현재 일자 가져오는 함수
 * 
 * @return
 */
function cfGetCurrDate() {
	currdate = new Date();

	var tmpyy  = currdate.getYear();
	var ls_yy  = (tmpyy > 99)  ? tmpyy : 1900 + tmpyy;

	var tmpmon = currdate.getMonth();
	var ls_mon = (tmpmon < 9)  ? "0" + (tmpmon + 1) : tmpmon + 1 ;

	var tmpday = currdate.getDate();
	var ls_day = (tmpday < 10) ? "0" + tmpday : tmpday ;

	return ls_yy.toString() + ls_mon.toString() + ls_day.toString() ;
}

/**
 * return date from date string
 * 
 * @param date :
 *            2009-01-01 or 20090101 or 01012009
 * @param format :
 *            yyyy-MM-dd or yyyyMMdd or ddMMyyyy
 */
function cfGetDate(strDate, format) {
	var year = 0, month = 0, day = 0;
	if (format == "yyyy.MM.dd" || format == "yyyy-MM-dd"
			|| format == "yyyy/MM/dd") {
		year = strDate.substr(0, 4);
		month = strDate.substr(5, 2);
		day = strDate.substr(8, 2);
	} else if (format == "yyyyMMdd") {
		year = strDate.substr(0, 4);
		month = strDate.substr(4, 2);
		day = strDate.substr(6, 2);
	} else if (format == "dd.MM.yyyy" || format == "dd/MM/yyyy"
			|| format == "dd-MM-yyyy") {
		year = strDate.substr(6, 4);
		month = strDate.substr(3, 2);
		day = strDate.substr(0, 2);
	} else if (format == "ddMMyyyy") {
		year = strDate.substr(4, 4);
		month = strDate.substr(2, 2);
		day = strDate.substr(0, 2);
	} else if (format == "MM.dd.yyyy" || format == "MM/dd/yyyy"
		|| format == "MM-dd-yyyy") {
		year = strDate.substr(6, 4);
		month = strDate.substr(0, 2);		
		day = strDate.substr(3, 2);
	} else {
		alert('define a date format in cfGetDate function javascript');
	}
	return new Date(parseInt(year, 10), parseInt(month, 10) - 1, parseInt(day,
			10));
}

/**
 * return differreence between fromdate and todate
 * 
 * @param fromdate :
 *            date type
 * @param todate :
 *            date type
 */
function cfGetDateDiff(fromDate, toDate) {
	var oneDay = 1000 * 60 * 60 * 24;
	var diff = toDate.getTime() - fromDate.getTime();

	return Math.floor(diff / oneDay);
}

/**
 * return
 * 
 * @param select :
 *            select box
 * @param option :
 *            option that will be append
 * @param idx :
 *            option's index that will be append
 */
function cfAddOption(select, option, idx) {
	if (!idx)
		idx = select.options.length;
	select.options[idx] = option;
}

/**
 * return
 * 
 * @param obj :
 *            <input type text object
 */
function cfIsNull(obj) {	
	var ret = (obj.value.strip() == '');
	if (ret) {
		obj.select();
	}
	return ret;
}

/**
 * return integer
 * 
 * @param num :
 *            0.00
 */
function cfInt(num) {
	var intVal = parseInt(num);
	if (isNaN(intVal)) {
		intVal = 0;
	}
	return intVal;
}

/**
 * return array
 * 
 * @param obj :
 *            document.frm.part : <form name="frm"><input name="part"><input
 *            name="part"></form>
 */
function cfArray(obj) {
	var arr = [];
	if (!obj)
		return arr;
	
	if(obj.nodeName == "SELECT" || obj.nodeName == "INPUT"){
		arr.push(obj);
		return arr;
	}
	
	if (obj.length) {
		for ( var i = 0, len = obj.length; i < len; i++) {
			arr.push(obj[i]);
		}
	} else {
		arr.push(obj);
	}

	return arr;
}

/**
 * ,를 제거
 */
String.prototype.trimComma = function(){
	return this.replace(/,/g,"");
}

/**
 * chars의 문자열이외의 문자가 있으면 true
 */
String.prototype.exclude = function(chars){
	var ret = false;
	var allowChars = new String(chars);
	
    for (var i = 0; i < this.length; i++) {
       if(!allowChars.include(this.charAt(i))){
           ret = true;
           break;
       }
    }
    return ret;
}
/**
 * check decimal value 123.02
 */
String.prototype.isDecimal = function(){
	var chars = new String("0123456789.");	
	this.trimComma();
	this.strip();
	return !this.exclude(chars);
}
/**
 * check price value 1,123.02
 */
String.prototype.isPrice = function(){
	var chars = new String("0123456789.,");	
	//this.trimComma();
	this.strip();
	return !this.exclude(chars);
}
/**
 * check number value 1234567890
 */
String.prototype.isNumber = function(){
	var chars = new String("0123456789");
	this.trimComma();
	this.strip();	
	return !this.exclude(chars);
}
/**
 * check alphabet value a-z or A-Z
 */
String.prototype.isAlphabet = function(){
	var chars = new String("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ");
	this.strip();	
	return !this.exclude(chars);
}
/**
 * is this a valid PO No? 
 */
String.prototype.isValidPoNo = function(){
	var chars = new String("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-");
	this.strip();	
	return  !this.exclude(chars);
}
/**
 * number and alphabet
 */
String.prototype.isAlphabetNumber = function(){
	var chars = new String("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789");
	this.strip();	
	return  !this.exclude(chars);
}
/**
 * byte length
 */
String.prototype.byteLength = function(){
	var len = 0;
 
	if(this == null || this == undefined){
		return 0;
	}
	
	
	for(var i = 0; i < this.length; i++) {
			var c = escape(this.charAt(i));
			if(c.length == 1) len++;
			else if(c.indexOf("%u") != -1) len += 2;
			else if(c.indexOf("%") != -1) len += c.length / 3;
	}
  
	return len;
}

/**
 * URL 특수문자 인코딩 함수
 * 
 * @param data
 *            파라미터 데이터
 */
function cfUriEncode(data) {
	if (data != "") {
		var encdata = '';
		var datas = data.split('&');
		for (i = 0; i < datas.length; i++) {
			if (i == 0)
				encdata = datas[i];
			else
				encdata += encodeURIComponent("&") + datas[i];
		}
		datas = encdata.split('%');
		for (i = 0; i < datas.length; i++) {
			if (i == 0)
				encdata = datas[i];
			else
				encdata += encodeURIComponent("%") + datas[i];
		}
		datas = encdata.split('+');
		for (i = 0; i < datas.length; i++) {
			if (i == 0)
				encdata = datas[i];
			else
				encdata += encodeURIComponent("+") + datas[i];
		}
	} else {
		encdata = "";
	}
	return encdata;
}

