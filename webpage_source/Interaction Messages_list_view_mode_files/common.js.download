/**
 * 팝업창이 중앙에 뜨도록 설정값 문자열을 Return한다.
 * 예 : width=100, height=100, left=150, top=200
 * 
 * @param w : 팝업창 Width
 * @param h : 팝업창 Height
 */
function cfGetPosString(w, h) {
	var leftPos = (screen.width) ? (screen.width-w)/2 : 0;
	var topPos = (screen.height) ? (screen.height-h)/2 : 0;

	return 'width=' + w + ',height=' + h + ',left=' + leftPos + ', top='+ topPos;
}

function cfSetComma(str){
	str = str+'';//string 으로 바꿈.
	var pointIdx = str.indexOf('.');
	var decimal = pointIdx == -1 ? '': str.substring(pointIdx);
	var integer = pointIdx == -1 ? str: str.substring(0, pointIdx);
	var tmp = '';
	var cnt = 0;
	for ( var i = integer.length-1; i > -1; i--) {
		if(cnt>0 && cnt%3==0) tmp += ',';
		tmp += integer.charAt(i);
		cnt++;
	}
	var tmp2 = '';
	for ( var i = tmp.length-1; i > -1; i--) {
		tmp2 += tmp.charAt(i);
	}
	
	str = tmp2 + decimal;
	return str;
}

function cfGetParameterByName(name, url){
	if(!url){
		alert("Input URL first.");
		return;
	}
	name = name.replace(/[\[\]]/g, "\\$&");
	var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)");
	var results = regex.exec(url);
	return results[2];
}