 * @param gubun : 화면구분(N:신규, I:입고 O:출고, D:폐기, R:반납, A:재고조정)
 */
function cfItemAppprovalPop(id, indi, oType, form, pGubun) {
	var url = "";
	var w = 1050;
	var h = 500;
	
	var strPop = 'menubar=no,toolbar=no,location=no,directories=no,status=yes,scrollbars=yes,resizable=no,';
	strPop += cfGetPosString(w, h);
	
//	var paramForm = Form.serialize($(form));
	var paramForm = $(form);
	var params = {};
	params['apprId'] = id;
	params['indi'] = indi;
	params['oType'] = oType;
	params['pGubun'] = pGubun;

	if(pGubun == 'N'|| pGubun == 'O' || pGubun == 'D' || pGubun == 'M'){
//		window.open('/common/ItemApprovalPop_new.jsp?' + $j.param(params) + '&'+ paramForm, 'ItemApprovalPop', strPop);		
		w = window.open(url, 'App_popup', strPop);
		w.focus();
		
		paramForm.action='/common/ItemApprovalPop_new.jsp?' + $j.param(params);
		paramForm.target='App_popup';
		paramForm.submit();
	    
	}else if(pGubun == 'I' || pGubun == 'A'){
//		window.open('/common/ItemApprovalPop_in.jsp?' + $j.param(params) + '&'+ paramForm, 'ItemApprovalPop', strPop);
		w = window.open(url, 'App_popup', strPop);
		w.focus();
		
		paramForm.action='/common/ItemApprovalPop_in.jsp?' + $j.param(params);
		paramForm.target='App_popup';
		paramForm.submit();
	}
}

