		form.action = actionUrl + "&t=" + (new Date()).getTime();
	}else{
		form.action = actionUrl + "?t=" + (new Date()).getTime();
	}
		
	if( popWin == null){
		form.submit();
	}else{
		form.target = "ServiceOrderDetailPopup"; 
		form.submit();
		popWin.focus();
	}
}

/*
 * *
 * check if the times in Service Order are valid 
 */
function cfValidTime(time){
	var valid = true;
	var timeValue = "";
	if( typeof time === "object" ){
		timeValue = time.value;
	} else { 
		timeValue = time;
	}	
	
	var arrTime = timeValue.split(":");
		
	if(arrTime.length != 3){
		valid = false;
	}else if(timeValue == "00:00:00"){
		valid = false;
	}
	
	return valid;
}


function cfMinus(arr1, arr2){
	var arrM = [];

	for(var i = 0, len = arr1.length; i < len; i++){
		var src =  arr1[i];
		var exist = false;
		for(var j = 0, len2 = arr2.length; j < len2; j++){
				if( arr2[j] == src){
					exist = true;
					break;
				}
		}
		
		if(exist){			
		}else{
			arrM.push(src);
		}
		
	}//for(var i = 0, len = arr1.length; i < len; i++){
	return arrM;
}




function cfGetByteLength(str){
	var len = 0;
  
	if(str == null)
		return 0;
  
	for(var i = 0; i < str.length; i++) {
			var c = escape(str.charAt(i));
			if(c.length == 1) len++;
			else if(c.indexOf("%u") != -1) len += 2;
			else if(c.indexOf("%") != -1) len += c.length / 3;
	}
  
	return len;	
}





