/**
 * 조회기간이 일정기간을 넘지 않도록
 * 
 * @param maxDays : 최대 조회가능 기간(30 등)
 * @param from : from date
 * @param to : to date
 * @param format : format
 *            
 */
function cfInAllowedPeriod(maxDays, from, to, format){
	var fromDate = cfGetDate(from.value, format);
	var toDate = cfGetDate(to.value, format);
	var diff = cfGetDateDiff(fromDate, toDate);
	return (diff <= maxDays);
}

