function clickTopHelpSEA() {
    var menLvl = '';
    menLvl = parent.$('leftMenuForm').titleDir.value;
    helpPopSEA(menLvl);
}
function helpPopSEA(id) {
    $form = $j("#formHelp");
    $form.find('input[name="MENUID"]').val(id);
    popupHelpSEA($form[0]);
}
function popupHelpSEA(form) {
    var url = "/common/HelpPop.jsp";
    var target = "popupHelp";
    var popWin = window
            .open(
                    "",
                    target,
                    'toolbar=no,location=no,directories=no,status=no,menubar=no,resizable=yes,copyhistory=no,scrollbars=yes,top=50,left=100,width=800,height=530');
    form.action = url;
    if (popWin == null) {
        form.submit();
    } else {
        $j(popWin.document).ready(function() {
            form.target = target;
            form.submit();
            popWin.focus();
        });
    }
}    

function addSupportLink(){
    var tableTr = $j('.title:eq(0)').parent('tr');
    var tableTitle = $j('.title:eq(0)').parent('tr').parent();
    var tdCnt = 0;
    //Title 우측에 버튼 있나 검사.
    $(tableTr).find('td').each(function(){
        tdCnt++;
    });
    var titleDiv = $j('#titleDiv').html();
    if(titleDiv == null || titleDiv == ""){
    	$j('#titleDiv').html('&nbsp;');
    }
    
    
    var  supportLinkTxt = '<td class="suport_link1"><a href="javascript:clickTopHelpSEA();" title="Help"><u>Help</u></a></td>'
    	+ '<td class="suport_link1"><a href="javascript:qnaOpenPopupSEA();" title="Q&A"><u>Q&A</u></a></td>'
        + '<td class="suport_link"><a href="javascript:contactUsOpenPopupSEA();" title="Contact Us"><u>Contact Us</u></a></td>';
    //Title 우측에 버튼 없으면 타이틀라인 끝에 링크 추가.
    if( tdCnt == 1){
        tableTr.append(supportLinkTxt);
    }else{ //Title 우측에 버튼 있으면 타이틀 라인 위에 링크 추가.
   	 $(tableTitle).prepend("<tr><td width='100%' colspan='10'>"
   			              + "<table width='100%' border='0' cellspacing='0' cellpadding='0'><tr><td width='*'>&nbsp;</td>"
   	                      + supportLinkTxt+"</tr></table></td></tr>");
    }	
	
}




